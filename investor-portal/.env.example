# Copy to .env and fill in from DocuSign demo Admin > Apps & Keys
DS_INTEGRATION_KEY=
DS_USER_ID=
DS_ACCOUNT_ID=
DS_PRIVATE_KEY_PATH=private.key
DS_AUTH_SERVER=account-d.docusign.com
DS_BASE_PATH=https://demo.docusign.net/restapi

# Salesforce org alias used by `sf org display` (dev-machine POC auth)
SF_ORG_ALIAS=plaid

# Django
DJANGO_SECRET_KEY=dev-only-secret-change-me
PORTAL_BASE_URL=http://localhost:8000
