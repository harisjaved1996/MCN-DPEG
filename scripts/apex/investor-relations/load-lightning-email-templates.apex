// Loads/refreshes the Lightning (SFX) EmailTemplate RECORDS in the IR_Email_Templates_Lightning
// folder via direct DML (NOT Metadata API deploy). EmailTemplate is a real sObject, so these
// records are reproduced as DATA. Idempotent: upserts by DeveloperName, safe to re-run.
//
// Loads THREE templates, all into IR_Email_Templates_Lightning:
//   1. IR Lead Notification Email     (IR_Lead_Notification_Email)
//   2. Investor Welcome Email         (Investor_Welcome_Email_LTN)
//   3. IR Offering Notification Email (IR_Offering_Notification_Email)
//
// Source of truth (diffable copies of what this script writes):
//   scripts/email-templates/investor-relations/<name>.html  and  .json
// Apex has no filesystem access, so each body is embedded below as base64. If a .html changes,
// regenerate its blob and keep the matching .json in sync.
//
// MEASURED - do not re-derive without re-testing (full writeups live in the .json files):
//   1. Markup cannot be set via DML for TemplateType='custom' (SFX). Platform rule, not FLS.
//   2. IsBuilderContent is createable=false/updateable=false - never settable by any API load.
//   3. EmailTemplate.DeveloperName is unique ORG-WIDE, not per-folder. Hence the _LTN suffix on
//      the welcome template, which collides with a pre-existing classic template otherwise.
//   4. TemplateStyle is createable=true but updateable=false - set on INSERT only, never UPDATE.
//
// SIZE: this is anonymous Apex, capped at ~32,000 characters INCLUDING the base64 blobs. That is
// why this loops over a definition list instead of repeating a block per template, and why the
// .html files are tightly indented and carry no HTML comments.

// --- Resolve the shared folder once. NEVER hardcode a Folder Id. ---
List<Folder> folders = [
    SELECT Id FROM Folder
    WHERE DeveloperName = 'IR_Email_Templates_Lightning' AND Type = 'EmailTemplate'
    LIMIT 1
];
if (folders.isEmpty()) {
    throw new System.StringException(
        'Cannot load Lightning email templates: no Email folder with DeveloperName ' +
        '\'IR_Email_Templates_Lightning\' exists in this org. Deploy ' +
        'force-app/main/default/email/IR_Email_Templates_Lightning.emailFolder-meta.xml first.'
    );
}
Id folderId = folders[0].Id;

// --- Template definitions. One map per template; body held as base64. ---
List<Map<String, String>> defs = new List<Map<String, String>>();

defs.add(new Map<String, String>{
    'dev' => 'IR_Lead_Notification_Email',
    'name' => 'IR Lead Notification Email',
    'subject' => 'New Investor Onboarding lead in the IR queue',
    'entity' => 'Lead',
    'desc' => 'Lightning (SFX) notification sent to Investor Onboarding Queue members when a new Investor Onboarding lead arrives. Sent by IR_Lead_Notification_Flow to each active queue member (recipientId = the member User). RelatedEntityType is Lead per requirement, but the body carries NO Lead merge fields - relatedRecordId is rejected alongside a User recipientId. See IR_Lead_Notification_Email.json.',
    'b64' => ''
});

defs.add(new Map<String, String>{
    'dev' => 'Investor_Welcome_Email_LTN',
    'name' => 'Investor Welcome Email',
    'subject' => 'Welcome to DPEG Investor Relations, {{{Recipient.FirstName}}}',
    'entity' => 'Contact',
    'desc' => 'Lightning (SFX) welcome email sent to a newly created Contact with the Investor record type. Sent by Investor_Welcome_Flow with recipientId = the new Contact and logEmailOnSend = true. Uses DeveloperName Investor_Welcome_Email_LTN because EmailTemplate.DeveloperName is unique org-wide and a classic template already holds Investor_Welcome_Email.',
    'b64' => ''
});

defs.add(new Map<String, String>{
    'dev' => 'IR_Offering_Notification_Email',
    'name' => 'IR Offering Notification Email',
    'subject' => 'New Offering awaiting review: %%RECORDNAME%%',
    'entity' => 'Offering__c',
    'desc' => 'Lightning (SFX) notification for Offering Queue members. Sent by IR_Offering_Notification_Flow via the OfferingEmailSender Apex invocable, which looks this record up by DeveloperName and substitutes the %%RECORDNAME%%, %%RECORDID%%, %%BASEURL%% and %%FIRSTNAME%% tokens. This record IS the live body - editing this file and re-running the loader changes what recipients receive.',
    'b64' => ''
});

// --- Idempotent upsert-by-DeveloperName, in two bulk DML statements. ---
Set<String> devNames = new Set<String>();
for (Map<String, String> d : defs) {
    devNames.add(d.get('dev'));
}

Map<String, Id> existingByDev = new Map<String, Id>();
for (EmailTemplate t : [SELECT Id, DeveloperName FROM EmailTemplate WHERE DeveloperName IN :devNames]) {
    existingByDev.put(t.DeveloperName, t.Id);
}

List<EmailTemplate> toInsert = new List<EmailTemplate>();
List<EmailTemplate> toUpdate = new List<EmailTemplate>();

for (Map<String, String> d : defs) {
    String dev = d.get('dev');
    String html = EncodingUtil.base64Decode(d.get('b64')).toString();

    if (existingByDev.containsKey(dev)) {
        // DeveloperName, FolderId, TemplateType and TemplateStyle are deliberately omitted on
        // update: TemplateStyle is not updateable once set, and the others are identity/location
        // fields that a content refresh must never silently move.
        toUpdate.add(new EmailTemplate(
            Id = existingByDev.get(dev),
            Subject = d.get('subject'),
            HtmlValue = html,
            UiType = 'SFX',
            RelatedEntityType = d.get('entity'),
            Encoding = 'UTF-8',
            IsActive = true,
            Description = d.get('desc')
        ));
    } else {
        toInsert.add(new EmailTemplate(
            Name = d.get('name'),
            DeveloperName = dev,
            FolderId = folderId,
            Subject = d.get('subject'),
            HtmlValue = html,
            UiType = 'SFX',
            TemplateType = 'custom',
            RelatedEntityType = d.get('entity'),
            TemplateStyle = 'none',
            Encoding = 'UTF-8',
            IsActive = true,
            Description = d.get('desc')
        ));
    }
}

if (!toInsert.isEmpty()) {
    insert toInsert;
}
if (!toUpdate.isEmpty()) {
    update toUpdate;
}

System.debug(LoggingLevel.ERROR, 'TEMPLATES_LOADED inserted=' + toInsert.size() +
    ' updated=' + toUpdate.size());
for (EmailTemplate t : toInsert) {
    System.debug(LoggingLevel.ERROR, '  INSERTED ' + t.DeveloperName + ' -> ' + t.Id);
}
for (EmailTemplate t : toUpdate) {
    System.debug(LoggingLevel.ERROR, '  UPDATED  ' + t.Id);
}
