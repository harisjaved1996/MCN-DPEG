<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Delivery_Rate__c</fullName>
    <label>Delivery Rate</label>
    <formula>IF(Total_Recipients__c &gt; 0, Sent_Count__c / Total_Recipients__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <precision>5</precision>
    <scale>1</scale>
    <required>false</required>
    <type>Percent</type>
    <inlineHelpText>Sent divided by total recipients.</inlineHelpText>
</CustomField>
