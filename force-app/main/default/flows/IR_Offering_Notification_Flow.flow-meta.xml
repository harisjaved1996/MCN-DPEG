<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Notification_Email</name>
        <label>Send Notification Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>OfferingEmailSender</actionName>
        <actionType>apex</actionType>
        <description>Sends the IR Offering Notification Email to every active queue member in one call. The body and subject come from the stored EmailTemplate, looked up by DEVELOPER NAME (never an Id) so this flow deploys unchanged to any org: deploy the metadata, run scripts/apex/investor-relations/load-lightning-email-templates.apex, done. OfferingEmailSender substitutes %%RECORDNAME%%, %%RECORDID%%, %%BASEURL%% and %%FIRSTNAME%% into that template, which the standard Send Email action cannot do - see the class header for the four measured failure modes. Called once with the whole col_Users collection, NOT inside a loop: Messaging.sendEmail is capped at 10 invocations per transaction, so looping would cap the queue at 10 members.</description>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recipients</name>
            <value>
                <elementReference>col_Users</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>templateDeveloperName</name>
            <value>
                <stringValue>IR_Offering_Notification_Email</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recordName</name>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Add_User_Id</name>
        <label>Add User Id to Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>col_UserIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Group_Members.UserOrGroupId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Group_Members</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_Queue_Found</name>
        <label>Is Queue Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Queue Not Found</defaultConnectorLabel>
        <rules>
            <name>Queue_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>rec_Queue.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>rec_Queue.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Queue_Members</targetReference>
            </connector>
            <label>Queue Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Are_Members_Found</name>
        <label>Are Members Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Members</defaultConnectorLabel>
        <rules>
            <name>Members_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>col_Members</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Group_Members</targetReference>
            </connector>
            <label>Members Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Group_Member_A_User</name>
        <label>Is Group Member a User?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Group_Members</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not a User</defaultConnectorLabel>
        <rules>
            <name>Is_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Group_Members.UserOrGroupId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>005</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_User_Id</targetReference>
            </connector>
            <label>Is User</label>
        </rules>
    </decisions>
    <decisions>
        <name>Are_Active_Users_Found</name>
        <label>Are Active Users Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Active Users</defaultConnectorLabel>
        <rules>
            <name>Active_Users_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>col_Users</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Notification_Email</targetReference>
            </connector>
            <label>Active Users Found</label>
        </rules>
    </decisions>
    <description>Notifies every active member of the Offering Queue by email when a new Offering lands in that queue. Pairs with IR_Offering_Assign_to_Queue, the BEFORE-save flow that sets OwnerId to the queue on the same insert - that assignment commits before this AFTER-save flow evaluates, so $Record.OwnerId already reflects the queue owner here. Scoped to Create only, so a member taking ownership later does not re-trigger a notification. Subject and body come from the IR_Offering_Notification_Email EmailTemplate, resolved by DeveloperName at run time and merged by the OfferingEmailSender Apex invocable - the template record is the single source of truth for the wording, and this flow holds no copy of it. PORTABILITY: nothing here is org-specific. Deploy this metadata to a new org, run scripts/apex/investor-relations/load-lightning-email-templates.apex to create the template records, and it works with no hand-building. Fails closed at every stage - if the queue, its members, an active user among them, or the template cannot be resolved, the flow ends without sending rather than blocking the Offering save.</description>
    <environments>Default</environments>
    <interviewLabel>IR Offering Notification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>IR Offering Notification</label>
    <loops>
        <name>Loop_Group_Members</name>
        <label>Loop Group Members</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>col_Members</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Is_Group_Member_A_User</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Active_Users</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Offering_Queue</name>
        <label>Get Offering Queue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Queue_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Offering_Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <outputReference>rec_Queue</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Queue_Members</name>
        <label>Get Queue Members</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Are_Members_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>GroupId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>rec_Queue.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>GroupMember</object>
        <outputReference>col_Members</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>UserOrGroupId</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Active_Users</name>
        <label>Get Active Users</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Are_Active_Users_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>col_UserIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>User</object>
        <outputReference>col_Users</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>FirstName</queriedFields>
        <queriedFields>Email</queriedFields>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Offering_Queue</targetReference>
        </connector>
        <filterFormula>LEFT(CASESAFEID({!$Record.OwnerId}), 3) = "00G"</filterFormula>
        <object>Offering__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>rec_Queue</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Group</objectType>
    </variables>
    <variables>
        <name>col_Members</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>GroupMember</objectType>
    </variables>
    <variables>
        <name>col_UserIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>col_Users</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>User</objectType>
    </variables>
</Flow>
